{
  "name": "sebs7n-ui",
  "version": "0.4.0",
  "description": "Design system para React: Geist (Vercel) sobre las primitivas de shadcn/ui base-nova (Base UI).",
  "keywords": [
    "design-system",
    "react",
    "tailwindcss",
    "tailwind-v4",
    "base-ui",
    "shadcn-ui",
    "geist",
    "components",
    "ui",
    "nextjs",
    "accessibility"
  ],
  "license": "MIT",
  "author": "sebafermanelli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebafermanelli/sebs7n-ui.git"
  },
  "homepage": "https://github.com/sebafermanelli/sebs7n-ui#readme",
  "bugs": {
    "url": "https://github.com/sebafermanelli/sebs7n-ui/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "src/styles",
    "tokens",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./src/styles/theme.css",
    "./variants/*": {
      "types": "./dist/variants/*.d.ts",
      "import": "./dist/variants/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js"
    },
    "./*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "tokens": "node scripts/gen-colors.mjs",
    "build": "npm run build:js && npm run build:css",
    "build:js": "tsc -p tsconfig.build.json",
    "build:css": "tailwindcss -i src/styles/build.css -o dist/styles.css --minify",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "size": "size-limit"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.8.0",
    "geist": "^1.7.2",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7"
  },
  "peerDependenciesMeta": {
    "geist": {
      "optional": true
    }
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@size-limit/preset-small-lib": "^14.0.0",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "size-limit": "^14.0.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
