{
  "name": "sebs7n-ui",
  "version": "2.15.0",
  "description": "Design system para React con el lenguaje visual de iCloud web sobre las primitivas de shadcn/ui base-nova (Base UI).",
  "keywords": [
    "design-system",
    "react",
    "tailwindcss",
    "tailwind-v4",
    "base-ui",
    "shadcn-ui",
    "components",
    "ui",
    "nextjs",
    "accessibility"
  ],
  "license": "MIT",
  "author": "sebafermanelli",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sebafermanelli/sebs7n-ui.git"
  },
  "homepage": "https://github.com/sebafermanelli/sebs7n-ui#readme",
  "bugs": {
    "url": "https://github.com/sebafermanelli/sebs7n-ui/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "agents",
    "dist",
    "src/styles",
    "tokens",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./src/styles/theme.css",
    "./labels": {
      "types": "./dist/lib/labels.d.ts",
      "import": "./dist/lib/labels.js"
    },
    "./variants/*": {
      "types": "./dist/variants/*.d.ts",
      "import": "./dist/variants/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js"
    },
    "./tokens/*.json": "./tokens/*.json",
    "./*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "tokens": "node scripts/gen-colors.mjs",
    "subpaths": "node scripts/gen-subpaths.mjs",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node scripts/gen-agent-guide.mjs && npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "size": "size-limit"
  },
  "peerDependencies": {
    "@base-ui/react": ">=1.8.0 <1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "embla-carousel-react": "^8.6.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.0",
    "sonner": "^2.0.7"
  },
  "peerDependenciesMeta": {
    "@dnd-kit/core": {
      "optional": true
    },
    "@dnd-kit/sortable": {
      "optional": true
    },
    "@dnd-kit/utilities": {
      "optional": true
    },
    "embla-carousel-react": {
      "optional": true
    },
    "recharts": {
      "optional": true
    }
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.47.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@size-limit/preset-small-lib": "^14.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "embla-carousel-react": "^8.6.0",
    "jsdom": "^29.1.1",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "recharts": "^3.10.1",
    "size-limit": "^14.0.0",
    "sonner": "^2.0.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
